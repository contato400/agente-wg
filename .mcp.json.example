{
  "_comentario": "Modelo. Copie para .mcp.json e preencha pelas variáveis de ambiente. NUNCA cole chave de API neste arquivo. Os conectores do claude.ai (Metricool, Windsor, Atomicat, Canva, Google) também podem ser usados direto pela conta, sem este arquivo; nesse caso ajuste os nomes das ferramentas em .claude/settings.json.",
  "mcpServers": {
    "metricool": { "type": "http", "url": "${METRICOOL_MCP_URL}" },
    "windsor": { "type": "http", "url": "${WINDSOR_MCP_URL}" },
    "atomicat": { "type": "http", "url": "${ATOMICAT_MCP_URL}" },
    "canva": { "type": "http", "url": "${CANVA_MCP_URL}" },
    "google-sheets": { "type": "http", "url": "${GOOGLE_SHEETS_MCP_URL}" }
  }
}
